{
  "name": "TIGER PHOENIX Cleanroom",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "remoteEnv": {
    "TIGER_EXECUTION_PLANE": "codespace-cleanroom"
  },
  "postCreateCommand": "python3 -m pip install --user pytest",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
