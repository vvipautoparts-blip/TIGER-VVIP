{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VVIP TIGER Project Task",
  "type": "object",
  "required": [
    "code",
    "phase_code",
    "title",
    "priority",
    "workflow_status",
    "meta",
    "sections"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^G\\d{2}-\\d{2}$"
    },
    "phase_code": {
      "type": "string",
      "pattern": "^G\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string"
    },
    "workflow_status": {
      "enum": [
        "backlog",
        "ready",
        "in_progress",
        "blocked",
        "review",
        "qa",
        "done",
        "archived"
      ]
    },
    "meta": {
      "type": "object"
    },
    "sections": {
      "type": "object"
    },
    "acceptance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
