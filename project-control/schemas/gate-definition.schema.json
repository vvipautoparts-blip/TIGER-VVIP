{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vvip-tiger.example/schemas/gate-definition.schema.json",
  "title": "TIGER VERITY Gate Definition V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "evidence_class", "environment", "subject", "max_age_ms", "prerequisites", "required_facts", "fail_closed"],
  "properties": {
    "id": { "type": "string", "pattern": "^P(?:0[1-9]|1[0-9]|20)$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 180 },
    "evidence_class": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "environment": { "enum": ["LOCAL", "CI", "STAGING", "NON_RUNTIME", "PRODUCTION"] },
    "subject": { "type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|[A-Z][A-Z0-9_:-]{1,127})$" },
    "max_age_ms": { "type": "integer", "minimum": 1, "maximum": 2678400000 },
    "prerequisites": {
      "type": "array",
      "maxItems": 19,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^P(?:0[1-9]|1[0-9]|20)$" }
    },
    "required_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
    },
    "fail_closed": { "const": true }
  }
}
