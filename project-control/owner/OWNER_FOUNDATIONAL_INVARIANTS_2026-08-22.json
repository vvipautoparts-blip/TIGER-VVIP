    "fake_navigation": false,
    "fake_success": false,
    "dead_future_controls": false,
    "duplicate_current_authorities": false,
    "current_runtime_authorities_per_responsibility": 1,
    "research_current_authoritative_sources_when_problem_is_material_or_unfamiliar": true,
