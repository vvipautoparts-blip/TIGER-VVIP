{
  "status": "ACTIVE_OWNER_AUTHORITY",
  "effective_at": "2026-08-22",
  "design_horizon": "2026-2096+",
  "scope": "ENTIRE_PLATFORM",
  "precedence": {
    "extends": [
      "docs/architecture/OWNER_AUTHORITY_REGISTRY.md",
      "docs/superpowers/specs/2026-08-22-proximity-only-three-lane-interaction-design.md",
      "docs/superpowers/specs/2026-08-22-universal-rendezvous-platform-design.md",
      "docs/architecture/OWNER_SOVEREIGN_PAYMENT_RAIL_FABRIC_2026-08-22.md"
    ],
    "conflicting_active_runtime_or_current_docs": "SUPERSEDED_ON_COVERED_TOPICS",
    "git_history": "HISTORICAL_EVIDENCE_ONLY"
  },
  "automotive": {
    "parts_only": true,
    "whole_vehicle_listings_allowed": false,
    "whole_vehicle_sale_rental_inventory_allowed": false,
    "vehicle_models_or_miniatures_as_automotive_vehicle_inventory_allowed": false
  },
  "food": {
    "full_scope": true,
    "required_category_families": [
      "meat",
      "poultry",
      "fish_seafood",
      "dairy",
      "eggs",
      "grains_cereals",
      "bakery",
      "fruit",
      "vegetables",
      "fresh_produce",
      "frozen_food",
      "packaged_food",
      "beverages_policy_permitting",
      "future_food_categories"
    ]
  },
  "universal_provenance": {
    "origin_classification": ["local", "imported", "mixed", "unknown"],
    "fields": [
      "country_of_origin",
      "brand",
      "manufacturer",
      "producer",
      "importer",
      "distributor",
      "supplier",
      "batch_or_lot",
      "certification_refs",
      "condition",
      "source",
      "verification_state",
      "freshness"
    ]
  },
  "global_architecture": {
    "single_country_master": false,
    "hardcoded_launch_country": false,
    "separate_contexts": [
      "incorporation_jurisdiction",
      "deployment_region",
      "user_location",
      "entity_location",
      "market_geography",
      "data_residency_policy",
      "currency_settlement_context",
      "applicable_country_sector_policy"
    ],
    "applicable_law_bypass_allowed": false
