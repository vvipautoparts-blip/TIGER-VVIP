  "disclosure": {
    "classes": ["PUBLIC", "USER_OWN", "INTERNAL", "CONFIDENTIAL", "OWNER_ONLY"],
    "owner_only_requires_fresh_auth": true,
    "requester_receives_owner_approval_code": false,
    "short_lived_disclosure_lease": true,
    "repository_iam_must_align": true
