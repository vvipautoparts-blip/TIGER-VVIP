  "anti_tamper": {
    "sensitive_authority_server_side": true,
    "durable_client_secrets_allowed": false,
    "signed_builds": true,
    "attestation_for_high_risk_actions": true,
    "obfuscation_anti_debug_anti_tamper_rasp_where_appropriate": true,
    "build_provenance": true,
    "tampered_client_confers_server_authority": false
