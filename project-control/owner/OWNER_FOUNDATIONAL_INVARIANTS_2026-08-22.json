  "screen_capture": {
    "goal": "MAXIMUM_DIGITAL_PREVENTION_AND_ATTRIBUTION",
    "absolute_physical_camera_prevention_claim": false,
    "android_secure_surface": true,
    "android_integrity_and_capture_risk_signals": true,
    "apple_capture_detection_response": true,
    "web_absolute_prevention_claim": false,
    "forensic_watermark_for_protected_views": true
