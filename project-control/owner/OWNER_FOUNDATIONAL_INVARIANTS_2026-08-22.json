      "people_privacy_security_rights_constitution",
      "user_legitimate_goal_and_fairness",
      "platform_continuity_integrity_reputation",
      "owner_authority_and_legitimate_partner_interests_within_scope"
    ],
    "reason_code_required_for_high_impact_automation": true
  },
  "permissions": {
    "model": "SOVEREIGN_CAPABILITY_FABRIC",
    "surface": "THREE_DOTS_CONTROL_PERMISSIONS",
    "ordinary_features_default_available": true,
    "sensitive_permissions_default_granted": false,
    "fine_grained_internal_actions": true,
    "simple_grouped_user_interface": true,
    "server_side_authoritative": true,
    "owner_high_risk_requires_fresh_step_up": true,
    "owner_core_capabilities": [
      "PAYMENT_RAIL_VIEW_ALL",
      "PAYMENT_RAIL_CREATE",
      "PAYMENT_RAIL_EDIT_DRAFT",
      "PAYMENT_DESTINATION_ROTATE",
      "PAYMENT_PROVIDER_ONBOARD",
      "PAYMENT_RAIL_VERIFY",
      "PAYMENT_RAIL_ACTIVATE",
      "PAYMENT_RAIL_SUSPEND",
      "PAYMENT_RAIL_RETIRE",
      "PAYMENT_POLICY_EDIT",
      "PAYMENT_CHANGESET_APPROVE"
    ],
    "grant_fields": [
      "principal",
      "action",
      "resource_scope",
      "sector_scope",
      "entity_scope",
      "geo_policy_scope",
      "purpose",
      "grantor",
      "policy_version",
      "issued_at",
      "not_before",
      "expires_at",
      "delegability_ceiling",
      "audit_evidence_ref"
    ]
  },
  "delegation": {
    "owner_selects_partners": true,
    "partner_can_delegate_only_with_explicit_capability": true,
