    "granted_marker": "checked",
    "not_granted_marker": "unchecked",
    "checkbox_is_security_boundary": false,
    "high_risk_changes_require_confirmation_sheet_and_step_up": true
  },
  "owner_dashboard": {
    "same_capability_model": true,
    "separate_authorization_universe": false,
    "country_payment_profiles_visible": true,
    "payment_change_sets_visible": true,
    "payment_route_history_visible": true
