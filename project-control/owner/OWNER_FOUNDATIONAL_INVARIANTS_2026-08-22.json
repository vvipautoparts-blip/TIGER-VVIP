      "advertising",
      "campaigns",
      "ad_credits_packages",
      "paid_visibility",
      "explicitly_approved_platform_owned_services"
    ],
    "cycle_days": 14,
    "current_meter_resets_each_cycle": true,
    "reset_deletes_history": false,
    "ledger": "APPEND_ONLY_WITH_REVERSING_ADJUSTMENTS",
    "cycle_states": ["OPEN", "LOCKED", "RECONCILED", "STATEMENT_READY", "CLOSED"]
  },
  "currency": {
    "standard": "ISO_4217",
    "invent_exchange_rate_allowed": false,
    "financial_conversion_statement_required_fields": [
      "source_amount_currency",
      "destination_requested_currency",
      "exchange_rate",
      "rate_source_provider",
      "quote_timestamp",
      "quote_expiry",
      "fees",
      "result_amount",
      "provider_reference",
      "status",
      "reconciliation_evidence"
    ]
  },
  "owner_payment_control": {
    "model": "SOVEREIGN_PAYMENT_RAIL_FABRIC",
    "owner_is_root_authority": true,
    "final_activation_requires_owner": true,
    "fresh_step_up_required_for_activation_rotation_retirement": true,
    "purpose_scope": [
      "advertising",
      "campaigns",
      "ad_credits_packages",
      "paid_visibility",
      "explicitly_approved_platform_owned_services"
    ],
    "external_buyer_seller_deal_payments_allowed": false,
    "payment_numbers_hardcoded_in_application_code": false,
    "country_payment_profile_required": true,
    "provider_neutral_core": true,
    "new_rail_requires_core_rebuild": false,
    "active_configuration_is_versioned_immutable": true,
    "all_changes_use_change_sets": true,
    "atomic_activation": true,
    "rollback_to_last_verified_version": true,
