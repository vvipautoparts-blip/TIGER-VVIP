    "included_planes": [
      "repository",
      "pull_requests_and_branches",
      "codespace_filesystem",
      "docker_and_buildkit",
      "supabase_local",
      "github_actions_artifacts_and_logs",
      "github_actions_cache",
      "codespaces_and_prebuilds",
      "local_windows_wsl_docker_when_requested"
    ]
  },
  "storage_classes": [
    "S0_SOVEREIGN",
    "S1_EVIDENCE",
    "S2_REBUILDABLE",
    "S3_EPHEMERAL",
    "S4_STATEFUL_LOCAL"
  ],
  "automatic_delete_denied_for": [
    "CURRENT_ONLY_OWNER_AUTHORITY",
    "CANONICAL_SOURCE_REQUIRED_BY_CURRENT_RUNTIME",
    "REQUIRED_MIGRATIONS",
    "PRODUCTION_CONFIGURATION",
    "UNBACKED_STATEFUL_VOLUMES",
