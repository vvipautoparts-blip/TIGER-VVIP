{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["staging_identity", "ledger_before", "schema_before", "classification"],
  "additionalProperties": false,
  "properties": {
    "staging_identity": {
      "type": "object",
      "required": ["branch_name", "project_ref", "parent_project_ref", "production_project_ref", "healthy", "production_ref_equal"],
      "additionalProperties": false,
      "properties": {
        "branch_name": {"const": "lc04-sovereign-staging-20260807"},
        "project_ref": {"type": "string", "pattern": "^[a-z]{20}$"},
        "parent_project_ref": {"type": "string", "pattern": "^[a-z]{20}$"},
        "production_project_ref": {"type": "string", "pattern": "^[a-z]{20}$"},
        "healthy": {"const": true},
        "production_ref_equal": {"const": false}
      }
    },
    "ledger_before": {
      "type": "object",
      "required": ["entries", "phase_b_present"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["version", "name"],
            "additionalProperties": false,
            "properties": {
              "version": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1}
            }
          }
        },
        "phase_b_present": {"type": "boolean"}
      }
    },
    "schema_before": {
      "type": "object",
      "required": ["canonical", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "canonical": {"type": "boolean"},
        "fingerprint": {"type": "object"}
      }
    },
    "classification": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["STATE_A", "STATE_B", "STATE_C", "STATE_D", "STATE_E"]}
      }
    }
  }
}
