{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vvip-tiger.local/schemas/p07-data-dictionary.json",
  "type": "object",
  "required": ["phase", "name", "review_only", "entities", "relationships"],
  "properties": {
    "phase": {"type": "string", "const": "P07"},
    "name": {"type": "string", "minLength": 5},
    "review_only": {"type": "boolean"},
    "entities": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "required": [
          "name", "purpose", "columns", "primary_key", "foreign_keys", "unique_constraints",
          "check_constraints", "indexes", "owner", "data_classification", "retention", "lifecycle_states"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "purpose": {"type": "string", "minLength": 10},
          "columns": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["name", "data_type", "nullable", "default"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                "data_type": {"type": "string", "minLength": 2},
                "nullable": {"type": "boolean"},
                "default": {"type": ["string", "null"]}
              }
            }
          },
          "primary_key": {
            "type": "object",
            "required": ["columns"],
            "properties": {
              "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "foreign_keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["column", "ref_entity", "ref_column", "on_delete", "on_update"],
              "properties": {
                "column": {"type": "string"},
                "ref_entity": {"type": "string"},
                "ref_column": {"type": "string"},
                "on_delete": {"type": "string"},
                "on_update": {"type": "string"}
              }
            }
          },
          "unique_constraints": {"type": "array"},
          "check_constraints": {"type": "array"},
          "indexes": {"type": "array", "minItems": 1},
          "owner": {"type": "string", "enum": ["user", "platform", "shared"]},
          "data_classification": {"type": "string", "enum": ["public", "private", "sensitive", "admin"]},
          "retention": {"type": "string", "minLength": 4},
          "lifecycle_states": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["from", "to", "type", "label"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    }
  }
}
